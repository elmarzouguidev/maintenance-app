            { "weight": 500, "file": "fonts/figtree/figtree-latin-500-normal.woff2", "unicodeRange": "latin" },
            { "weight": 500, "file": "fonts/figtree/figtree-latin-ext-500-normal.woff2", "unicodeRange": "latin-ext" },
            { "weight": 600, "file": "fonts/figtree/figtree-latin-600-normal.woff2", "unicodeRange": "latin" },
            { "weight": 600, "file": "fonts/figtree/figtree-latin-ext-600-normal.woff2", "unicodeRange": "latin-ext" }
        ]
    }
