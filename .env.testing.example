# Test environment, loaded when APP_ENV=testing (php artisan test / vendor/bin/pest).
# Copy to .env.testing and fill in the credentials of a MySQL user that can manage maintenanceapp_testing.
APP_NAME=maintenanceapp
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=https://maintenanceapp.test

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=maintenanceapp_testing
DB_USERNAME=
DB_PASSWORD=
